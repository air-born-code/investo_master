# Copy to .env.local for local use. Never commit .env.local.
RESEND_API_KEY=re_replace_with_your_key
INVESTO_RECIPIENT_EMAIL=you@gmail.com
OPENROUTER_API_KEY=sk-or-v1-replace_with_your_key

# EDGAR requires a declared User-Agent carrying a real contact address, and returns
# 403 without one. Needed by add-assets.mjs and ingest-filings.mjs.
SEC_USER_AGENT=Your Name (you@example.com)

# Optional. FRED works without a key through the public CSV endpoint; a key adds
# series metadata and a higher rate limit.
FRED_API_KEY=

# Optional. Public root of the tracking site. The email is a digest and links to
# the site for depth; without this it names the pages but cannot link to them.
SITE_URL=
