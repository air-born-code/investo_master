{
  "name": "investo-master",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Long-term investment research, weekly publishing, and private email delivery.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "report:build:trial": "node scripts/build-trial.mjs",
    "report:check:trial": "node scripts/check-report.mjs reports/2026/2026-W29",
    "report:send:trial": "node --env-file=.env.local scripts/send-report.mjs reports/2026/2026-W29",
    "ingest:macro": "node --env-file-if-exists=.env.local scripts/ingest-macro.mjs",
    "ingest:macro:dry": "node --env-file-if-exists=.env.local scripts/ingest-macro.mjs --dry-run",
    "ingest:filings": "node --env-file-if-exists=.env.local scripts/ingest-filings.mjs",
    "ingest:filings:dry": "node --env-file-if-exists=.env.local scripts/ingest-filings.mjs --dry-run",
    "draft:issue": "node --env-file-if-exists=.env.local scripts/draft-issue.mjs .",
    "draft:issue:dry": "node scripts/draft-issue.mjs . --dry-run",
    "strategies:list": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('strategies'))if(f.endsWith('.md')&&f!=='README.md')console.log(f.replace(/\\.md$/,''))\"",
    "gates:check": "node scripts/check-gates.mjs",
    "gates:init": "node scripts/check-gates.mjs --init",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs && node scripts/serve-site.mjs",
    "issue:build": "node scripts/build-issue.mjs",
    "issue:check": "node scripts/check-report.mjs",
    "issue:send": "node --env-file=.env.local scripts/send-report.mjs",
    "data:build:baseline": "node scripts/build-baseline-data.mjs .",
    "report:build:baseline": "node scripts/build-baseline.mjs .",
    "report:check:baseline": "node scripts/check-report.mjs reports/2026/2026-W29-issue-001",
    "report:send:baseline": "node --env-file=.env.local scripts/send-report.mjs reports/2026/2026-W29-issue-001"
  }
}
